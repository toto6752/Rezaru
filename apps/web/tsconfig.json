{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ],
      "@rezaru/database": [
        "../../packages/database/src/index.ts"
      ],
      "@rezaru/workflow-schema": [
        "../../packages/workflow-schema/src/index.ts"
      ],
      "@rezaru/execution-engine": [
        "../../packages/execution-engine/src/index.ts"
      ],
      "@rezaru/ai-compiler": [
        "../../packages/ai-compiler/src/index.ts"
      ],
      "@rezaru/connectors": [
        "../../packages/connectors/src/index.ts"
      ],
      "@rezaru/ui": [
        "../../packages/ui/src/index.ts"
      ],
      "@rezaru/config": [
        "../../packages/config/src/index.ts"
      ],
      "@rezaru/observability": [
        "../../packages/observability/src/index.ts"
      ]
    },
    "allowJs": true,
    "noEmit": true
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
