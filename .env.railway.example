# ---------------------------------------------------------------------------
# Railway variables. Values in ${{ ... }} are Railway references and resolve
# automatically; the rest must be filled in by hand.
#
# Paste the matching block into Service -> Variables -> Raw Editor.
# ---------------------------------------------------------------------------

# === Service: web ==========================================================
NODE_ENV=production
DATABASE_URL=${{Postgres.DATABASE_URL}}
REDIS_URL=${{Redis.REDIS_URL}}
NEXT_PUBLIC_APP_URL=https://${{RAILWAY_PUBLIC_DOMAIN}}
BETTER_AUTH_URL=https://${{RAILWAY_PUBLIC_DOMAIN}}
# 32+ random characters
BETTER_AUTH_SECRET=
# base64-encoded 32-byte key; required in production, and it must never change
# afterwards or every stored connection secret becomes undecryptable
APP_ENCRYPTION_KEY=
DEMO_MODE=true
DEMO_AUTH_BYPASS=false
AI_PROVIDER=rule-based
AI_MODEL=gpt-5-mini
AI_BASE_URL=https://api.openai.com/v1
# Email delivery. SMTP_URL is an HTTP JSON endpoint, not an smtp:// string:
# the app POSTs {to, subject, text, from} to it and sends EMAIL_API_KEY as a
# bearer token. Resend accepts exactly this shape.
SMTP_URL=https://api.resend.com/emails
EMAIL_API_KEY=
EMAIL_FROM=OutcomeOS <onboarding@resend.dev>

# === Service: worker =======================================================
# NODE_ENV=production
# DATABASE_URL=${{Postgres.DATABASE_URL}}
# REDIS_URL=${{Redis.REDIS_URL}}
# BETTER_AUTH_SECRET=<same value as web>
# APP_ENCRYPTION_KEY=<same value as web>
# DEMO_MODE=true
# AI_PROVIDER=rule-based
# WORKER_CONCURRENCY=10
# WORKER_HEALTH_PORT=3001

# === Optional (both services) ==============================================
